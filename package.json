{
  "name": "jewellery-ai-customer-journey-orchestrator",
  "version": "1.0.0",
  "description": "Enterprise Jewellery AI Customer Journey Orchestrator with PostgreSQL, Gemini AI, and Human-in-the-Loop Governance",
  "private": true,
  "type": "module",
  "main": "backend/src/server.js",
  "scripts": {
    "build": "cd frontend && npm install --include=dev && npm run build && cd .. && npm install --include=dev",
    "start": "node backend/src/server.js",
    "dev": "node backend/src/server.js",
    "backend": "cd backend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "seed": "node database/db-runner.js --seed",
    "migrate": "node database/db-runner.js --migrate"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.14",
    "@google/generative-ai": "^0.21.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "keywords": [
    "jewellery",
    "ai",
    "customer-journey",
    "orchestrator",
    "gemini",
    "postgresql",
    "react",
    "express"
  ],
  "author": "Antigravity Senior Engineering Team",
  "license": "ISC"
}
